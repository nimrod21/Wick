{
  "name": "wick",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev":          "pnpm --filter @wick/shared build && pnpm -r --parallel dev",
    "dev:server":   "pnpm --filter @wick/server dev",
    "dev:web":      "pnpm --filter @wick/web dev",
    "build":        "pnpm -r build",
    "typecheck":    "pnpm -r typecheck",
    "migrate":      "pnpm --filter @wick/server migrate",
    "ask":          "tsx scripts/ask.ts",
    "keys":         "tsx scripts/keys.ts",
    "paper":        "tsx scripts/paper.ts",
    "test:guards":  "tsx scripts/test-guards.ts",
    "test:llm":     "tsx scripts/test-llm.ts",
    "test:bots":    "tsx scripts/test-bots.ts",
    "test:learn":   "tsx scripts/test-learn.ts",
    "smoke":        "tsx scripts/smoke.ts",
    "doctor":       "tsx scripts/doctor.ts",
    "pm2:start":    "pnpm build && pm2 start ecosystem.config.cjs",
    "pm2:restart":  "pm2 restart ecosystem.config.cjs",
    "pm2:stop":     "pm2 stop ecosystem.config.cjs",
    "pm2:delete":   "pm2 delete ecosystem.config.cjs",
    "pm2:logs":     "pm2 logs",
    "pm2:status":   "pm2 status"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.12",
    "ws": "^8.18.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["better-sqlite3", "esbuild"]
  }
}
